# OpenClaw Docker Environment Configuration
# Copy this file to .env and modify the values

# Docker image configuration
OPENCLAW_IMAGE=openclaw-gateway:latest

# Model configuration
MODEL_ID=meta-llama/Llama-3.3-70B-Instruct
BASE_URL=https://api.akashml.com/v1
API_KEY=
# API protocol type: openai-completions or anthropic-messages
# openai-completions: OpenAI protocol (for OpenAI, Gemini, etc.)
# anthropic-messages: Claude protocol (for Claude models, supports Prompt Caching)
API_PROTOCOL=openai-completions
# Model context window size
CONTEXT_WINDOW=200000
# Model max output tokens
MAX_TOKENS=8192

# Workspace configuration (do not change)
WORKSPACE=/home/node/.openclaw/workspace

# Mount directory configuration (change as needed)
# OpenClaw data directory (contains config files, workspace, etc.)
OPENCLAW_DATA_DIR=~/.openclaw

# Optional: container startup user UID:GID
# Default 0:0 (root) for init.sh to auto-fix mount permissions, then drop to node user
# To align with host user, set to 1000:1000 or $(id -u):$(id -g) on Linux
OPENCLAW_RUN_USER=0:0

# Gateway configuration
## Gateway token for authentication (change as needed)
OPENCLAW_GATEWAY_TOKEN=2002
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=true
